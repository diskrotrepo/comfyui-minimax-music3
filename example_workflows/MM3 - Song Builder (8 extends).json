me":"audio","name":"audio","type":"AUDIO","link":5},{"localized_name":"audioUI","name":"audioUI","type":"AUDIO_UI","widget":{"name":"audioUI"},"link":null}],"outputs":[{"localized_name":"audio","name":"audio","type":"AUDIO","links":null}],"properties":{"Node name for S&R":"PreviewAudio"},"widgets_values":[]},{"id":11,"type":"MiniMaxMusic3Extend","pos":[1060.0518535184651,458.61890160281155],"size":[360,420],"flags":{},"order":5,"mode":0,"inputs":[{"localized_name":"state","name":"state","type":"MINIMAX_MM3_STATE","link":6},{"localized_name":"song_audio","name":"song_audio","shape":7,"type":"AUDIO","link":7},{"localized_name":"audio_duration","name":"audio_duration","type":"FLOAT","widget":{"name":"audio_duration"},"link":null},{"localized_name":"seed","name":"seed","type":"INT","widget":{"name":"seed"},"link":null},{"localized_name":"continue_from_seconds","name":"continue_from_seconds","shape":7,"type":"FLOAT","widget":{"name":"continue_from_seconds"},"link":null},{"localized_name":"prompt","name":"prompt","shape":7,"type":"STRING","widget":{"name":"prompt"},"link":null},{"localized_name":"lyrics","name":"lyrics","shape":7,"type":"STRING","widget":{"name":"lyrics"},"link":null}],"outputs":[{"localized_name":"audio","name":"audio","type":"AUDIO","links":[8,10]},{"localized_name":"state","name":"state","type":"MINIMAX_MM3_STATE","links":[9]},{"localized_name":"new_audio","name":"new_audio","type":"AUDIO","links":null}],"title":"Extend 2","properties":{"Node name for S&R":"MiniMaxMusic3Extend"},"widgets_values":[20,44,"fixed",30,"Global Metadata: Dark phonk, hard underground hip-hop, Memphis rap. 140 BPM half-time, C sharp minor, phrygian color with dissonant cluster stabs. Menacing and relentless throughout, cold aggressive pressure that keeps escalating, a violent peak in the middle and an abrupt dead-stop ending. Gym, street racing, fight-scene, adrenaline late-night listening. Basement production: gritty distorted texture, heavy tape saturation pushed into clipping, bit-crushed edges, cassette grime, low-end bloated and overdriven, everything slightly detuned and hostile.\nVocal Details: Low aggressive vocal, gritted-teeth delivery between a growl and a chant, pushed forward in the mix and doubled hard left and right, on-top-of-the-beat attacking phrasing, raspy dark timbre. Sparse shouted gang-vocal answers, occasional pitched-down whispered threats and reversed vocal swells drowned in dark plate reverb and slapback delay. Long instrumental stretches where the beat alone does the talking.\nArrangement: Punishing 808 drums with a distorted sliding sub-bass kick that saturates the whole low end, cracking rim-knock snare dead on the beat, double-time skittering hi-hats with sharp triplet bursts, cowbell stabs from classic phonk. Detuned horror-movie bell melody as the harmonic bed, gnarled low brass hits answering the vocal lines, constant tape grime and air-raid siren swells as texture. Intro: lone detuned bell loop over cassette hiss, a pitched-down voice mutters once, then the 808s slam in all at once. Verses: minimal and heavy — 808 kick, snare, hats, bells, whispered ad-libs between lines. Instrumental sections: the bell melody and brass stabs trade blows over the beat, sub-bass slides dragging underneath, occasional distorted siren far in the background. Bridge: drums cut to silence except hiss and one detuned bell, a whispered count-in, then the beat drops back twice as hard with layered gang shouts. Outro: everything cuts at once mid-bar, leaving one last bell note ringing into tape hiss.","Fat ass bitches at da clurb (at the clurb )\nFat ass bitches at da  clurb (at the clurb )\nFat ass bitches at da  clurb (at the clurb )\nFat ass bitches at da  clurb (at the clurb )\nFat ass bitches at da  clurb  (at the clurb )\nFat ass bitches at da  clurb (at the clurb )"]},{"id":21,"type":"PreviewAudio","pos":[1060.0518535184651,938.6189016028115],"size":[360,102],"flags":{},"order":6,"mode":0,"inputs":[{"localized_name":"audio"